# Where the Orbit Kernel lives - the SAME Kernel the tenant-facing
# Gateway uses. Private network only, never a public URL.
KERNEL_URL=http://localhost:8000

# Must exactly match the Kernel's ADMIN_GATEWAY_SHARED_SECRET.
# Deliberately a different value than the tenant-facing orbit-gateway's
# GATEWAY_SHARED_SECRET, so the two front doors rotate independently.
ADMIN_GATEWAY_SHARED_SECRET=changeme-admin-gateway-shared-secret

NODE_ENV=development
